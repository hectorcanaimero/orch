# Generated by `orch init --template python-api`. Edit freely.
#
# The full default schema (concurrency, budget, retry, dashboard, github,
# notifications, presentation) is applied at load time by
# `orchestrator.config_loader._apply_defaults` — only override what you need.

concurrency:
  global_max: 4
  per_provider:
    claude: 2
    codex: 1
    opencode: 2

dispatch:
  worktree_mode: true       # per-task git isolation — recommended for python-api
  base_branch: main

vcs:
  provider: github
  auto_pr: false            # flip to true once you're ready for auto PRs
  ci_max_retries: 1

github:
  test_command: pytest      # what CI runs on every PR
  auto_merge: false         # opt-in; requires branch protection

# Uncomment to enable a stakeholder-shareable dashboard URL:
# dashboard:
#   tunnel:
#     enabled: true
#     auto_start: true
