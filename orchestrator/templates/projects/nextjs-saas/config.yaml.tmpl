# Generated by `orch init --template nextjs-saas`. Edit freely.
#
# The full default schema (concurrency, budget, retry, dashboard, github,
# notifications, presentation) is applied at load time by
# `orchestrator.config_loader._apply_defaults` — only override what you need.

concurrency:
  global_max: 4
  per_provider:
    claude: 2
    codex: 1
    opencode: 2

dispatch:
  worktree_mode: true       # per-task git isolation — recommended
  base_branch: main

vcs:
  provider: github
  auto_pr: false            # flip to true once you're happy with the plan
  ci_max_retries: 1

github:
  # `pnpm test` runs typecheck + unit + Playwright smoke via the shipped
  # CI workflow. Adjust once you know your project's exact command.
  test_command: pnpm test
  auto_merge: false         # opt-in; requires branch protection

# Client-shareable dashboard: enable when you want the stakeholder view
# live for the person paying the invoices.
dashboard:
  tunnel:
    enabled: true
    auto_start: true

# Ping yourself the moment a task blocks — SaaS deploys have long feedback
# loops; catching a Clerk key mismatch at task-block time saves a lot of
# staring at CI logs.
notifications:
  slack_webhook: ""
