# Generated by `orch init --template chatbot-whatsapp`. Edit freely.
#
# The full default schema (concurrency, budget, retry, dashboard, github,
# notifications, presentation) is applied at load time by
# `orchestrator.config_loader._apply_defaults` — only override what you need.

concurrency:
  global_max: 3
  per_provider:
    claude: 2       # keep 1 slot free for interactive `claude` sessions
    codex: 1
    opencode: 2

dispatch:
  worktree_mode: true     # per-task git isolation — recommended
  base_branch: main

vcs:
  provider: github
  auto_pr: false          # flip to true once branch protection is on
  ci_max_retries: 1

github:
  test_command: pytest
  auto_merge: false       # opt-in; requires branch protection

# The typical delivery: enable the tunnel and send the URL to your client
# so they see task-by-task progress on their bot without asking you.
dashboard:
  tunnel:
    enabled: true
    auto_start: true

# Get pinged the moment the bot is stuck instead of finding out from your
# client — plug in a Slack webhook you check on your phone.
notifications:
  slack_webhook: ""
