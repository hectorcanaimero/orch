  "cards": [
    {
      "dot": "violet",
      "title": "Estado",
      "items": [
        "internal/state (SQLite) es la única fuente de verdad del estado de las tareas",
        "tasks.json es el DAG estático, nunca el estado",
        "los agentes reportan por internal/mcp (orch_set_status, orch_block), que escribe en internal/state"
      ]
    },
    {
      "dot": "cyan",
      "title": "Dependencias",
      "items": [
        "engine no importa dashboard, publish, router ni notify",
        "cli resuelve las rutas de model_router.yaml y conecta notify"
      ]
    },
    {
      "dot": "amber",
      "title": "Hojas",
      "items": [
        "config, notify, pricing, pyfmt, skills, telemetry, templates, tunnel, vcs y worktree no importan nada interno"
      ]
    }
