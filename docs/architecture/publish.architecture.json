  "cards": [
    {
      "dot": "violet",
      "title": "Tres destinos, un mismo sitio",
      "items": [
        "publish.Export escribe el sitio igual para dir, git y cloud",
        "--to git clona origin en temporal y nunca toca el checkout",
        "--watch vuelve a publicar solo si cambia el digest del snapshot"
      ]
    },
    {
      "dot": "rose",
      "title": "Secretos",
      "items": [
        "Un publish token por proyecto; el admin token queda en la máquina del operador",
        "El Worker guarda solo SHA-256 de los tokens",
        "orch cloud rotate emite un view token nuevo; el enlace viejo pasa a 404"
      ]
    },
    {
      "dot": "cyan",
      "title": "Lo que ve el cliente",
      "items": [
        "El enlace no nombra el proyecto: el view token es el único secreto",
        "Referrer-Policy: no-referrer y noindex en cada respuesta",
        "KV es eventualmente consistente: hasta un minuto en propagarse"
      ]
    }
  ]
