# orch events against a REAL database with real events —
# internal/state/testdata/orch-py-0.11.0.db, written by Python v0.11.0 (see
# its README.md). testdata/parity-project has zero events, so this is the
# only place the non-empty --json/human/--run paths get exercised.

exec orch events F0.T1 --json --project-root billing-api --project-id billing-api
! stderr .
stdout '"event_type":"dispatch"'
stdout '"event_type":"success"'
stdout '"ts":"2026-09-01T09:00:00\+00:00"'
stdout '"run_id":"fixture-run-0001"'
stdout '"project_id":"billing-api"'

exec orch events F0.T1 --project-root billing-api --project-id billing-api
stdout 'TS\s+EVENT\s+BACKEND\s+RUN'
stdout 'dispatch'
stdout 'success'
# shortRunID truncates "fixture-run-0001" (16 chars) to its first 8.
stdout 'fixture-'
! stdout 'fixture-run-0001'

exec orch events F1.T1 --run fixture-run-0001 --json --project-root billing-api --project-id billing-api
stdout '"task_id":"F1.T1"'
stdout '"event_type":"dispatch"'
! stdout 'F1\.T2'

exec orch events F1.T1 --run some-other-run --json --project-root billing-api --project-id billing-api
stdout '^\[\]$'

exec orch events F1.T2 --json --project-root billing-api --project-id billing-api
stdout '"event_type":"block"'

# --- no TASK_ID: the whole project ---------------------------------------
# New in Go; Python's parser requires the argument. The fixture's four rows
# span three tasks, so this is also where "the task column is load-bearing"
# is checked: the one-task table cannot show it.

exec orch events --json --project-root billing-api --project-id billing-api
! stderr .
stdout '"task_id":"F0.T1"'
stdout '"task_id":"F1.T1"'
stdout '"task_id":"F1.T2"'
stdout '"event_type":"block"'

exec orch events --project-root billing-api --project-id billing-api
stdout 'TS\s+TASK\s+EVENT\s+BACKEND\s+RUN'
stdout 'F0\.T1\s+dispatch'
stdout 'F1\.T2\s+block'

# Oldest first, across tasks, as the one-task form is.
exec orch events --tail 1 --project-root billing-api --project-id billing-api
stdout 'F1\.T2\s+block'
! stdout 'F0\.T1'

# --run narrows before --tail here too.
exec orch events --run some-other-run --json --project-root billing-api --project-id billing-api
stdout '^\[\]$'
