# orch doctor against the committed, real parity-project fixture — see
# testscript_test.go's Setup for how `proj` gets there (copied from
# testdata/parity-project at the repo root, NOT internal/graph's own
# same-named fixture, which is deliberately broken for validator tests).
#
# Assertions here are deliberately environment-independent: which backend
# CLIs happen to be installed on the machine running this test varies (a
# dev laptop with codex installed vs. a bare CI runner), so this doesn't
# assert on backend.* specifically. mcp.config is always absent in a
# freshly copied fixture (no .mcp.json ships with it) regardless of
# environment, so that's the one check asserted on by name.

# Non-zero exit both times: codex/opencode aren't on this fixture's PATH
# (only claude is), which is a real `error`-status check, not a fixture
# bug — exit 2 is doctor's own "at least one error" convention
# (internal/doctor.ExitCode), same as `orch validate`'s.
! exec orch doctor --project-root proj --project-id parity-project
stdout 'orch doctor · project=parity-project · backend=sqlite'
stdout 'mcp\.config'
stdout '/proj/.mcp.json not found'

! exec orch doctor --json --project-root proj --project-id parity-project
stdout '"project":\{"id":"parity-project"'
stdout '"backend":"sqlite"'
stdout '"name":"mcp\.config","status":"warn"'
stdout '"summary":\{"ok":[0-9]+,"warn":[0-9]+,"error":[0-9]+,"skip":[0-9]+\}'
