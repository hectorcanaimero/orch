# orch doctor against the committed, real parity-project fixture — see
# testscript_test.go's Setup for how `proj` gets there (copied from
# testdata/parity-project at the repo root, NOT internal/graph's own
# same-named fixture, which is deliberately broken for validator tests).
#
# Assertions here are deliberately environment-independent: which backend
# CLIs happen to be installed on the machine running this test varies (a
# dev laptop with codex installed vs. a bare CI runner), so this doesn't
# assert on backend.* specifically. mcp.config is always absent in a
# freshly copied fixture (no .mcp.json ships with it) regardless of
# environment, so that's the one check asserted on by name.

# Non-zero exit both times: codex/opencode aren't on this fixture's PATH
# (only claude is), which is a real `error`-status check, not a fixture
# bug — exit 2 is doctor's own "at least one error" convention
# (internal/doctor.ExitCode), same as `orch validate`'s.
! exec orch doctor --project-root proj --project-id parity-project
stdout 'orch doctor · project=parity-project · backend=sqlite'
stdout 'mcp\.config'
stdout '/proj/.mcp.json not found'

! exec orch doctor --json --project-root proj --project-id parity-project
stdout '"project":\{"id":"parity-project"'
stdout '"backend":"sqlite"'
stdout '"name":"mcp\.config","status":"warn"'
stdout '"summary":\{"ok":[0-9]+,"warn":[0-9]+,"error":[0-9]+,"skip":[0-9]+\}'
# The fixture has no budgets.yaml: the guardrail is off, which is a warning,
# and the path is resolved from the project (next to config.yaml), not from
# the directory doctor happens to be run in.
stdout '"name":"budget\.preset_sanity","status":"warn","detail":"[^"]*/proj/\.orchestrator/budgets\.yaml'

# A malformed config.yaml: config.Load fails, and that failure becomes its
# own `config.parse` error check rather than aborting before any other
# check runs (doctor.go:70-79's tolerant-load branch — this specific path
# had no test until Gemini flagged it on #183: "new behaviour without a
# test", rule 8). Seen red first: with the `else` branch that appends this
# check deleted, this assertion fails (no `config.parse` line at all,
# `orch doctor` instead runs against config.Defaults() silently).
! exec orch doctor --json --project-root badcfg --project-id badcfg
stdout '"name":"config\.parse","status":"error","detail":"config load failed:'
stdout '"exit_code":2'

# Same for a malformed model_router.yaml: router.Load fails -> its own
# `router.parse` error check (doctor.go:82-90). Also unseen by any test
# before this PR — same rule-8 finding, same "seen red without the else
# branch" verification.
! exec orch doctor --json --project-root badrouter --project-id badrouter
stdout '"name":"router\.parse","status":"error","detail":"router load failed:'
stdout '"exit_code":2'

-- badcfg/tasks.json --
{"meta":{},"phases":[],"tasks":[]}
-- badcfg/.orchestrator/config.yaml --
concurrency: [this is not a mapping
-- badrouter/tasks.json --
{"meta":{},"phases":[],"tasks":[]}
-- badrouter/.orchestrator/model_router.yaml --
claude/claude-sonnet-4-6: [this is not a mapping
