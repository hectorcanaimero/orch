# orch atomize against a small inline spec. Diff/list text ports Python's
# render_diff/render_list (own doc comment: parity is which sections exist
# and what they say, not byte-identical formatting — Python's own tests
# only assert on substrings too), cross-checked against a real
# `python -m orchestrator.atomize` run for the same fixture shape.
#
# Default --specs-dir is <project-root>/<cfg.spec_root> (bug 18 — cfg.
# spec_root defaults to "specs", not the "docs" this command used to
# hardcode, and is the same key prompt_builder composes a dispatched
# task's read-first path from). atomizeproj's specs live under specs/ for
# exactly that reason — putting them under docs/ would silently find
# nothing once this landed.

exec orch atomize --project-root atomizeproj --project-id atomizeproj
! stderr .
stdout '=== Atomizer diff ==='
stdout 'Specs escaneados: 1 archivos, 2 tasks encontradas'
stdout '\+ NUEVAS \(2\)'
stdout 'F0\.1\.T1'
stdout 'F0\.1\.T2'
stdout 'Para aplicar: agregá --apply'

# Dry-run never writes.
exec cat atomizeproj/tasks.json
stdout '"tasks":\[\]'

exec orch atomize --list --project-root atomizeproj --project-id atomizeproj
stdout 'Specs escaneados: 1 archivos'
stdout 'ID\s+PHASE\s+TITLE\s+MODEL\s+EST\s+DEPS'
stdout 'F0\.1\.T1.*0.*First task.*claude-sonnet-4-6.*2h'

# --apply writes tasks.json and a timestamped backup of the pre-apply file.
exec orch atomize --apply --project-root atomizeproj --project-id atomizeproj
stdout '✓ Escrito:'
stdout 'backup:'
exec cat atomizeproj/tasks.json
stdout '"id": "F0\.1\.T1"'
stdout '"id": "F0\.1\.T2"'

exec bash -c 'ls atomizeproj/tasks.json.bak-*'

# Idempotent: re-running --apply finds nothing new to write.
exec orch atomize --apply --project-root atomizeproj --project-id atomizeproj
stdout 'SIN CAMBIOS \(2\)'
stdout '\-\-apply pasado pero no hay cambios que aplicar\.'

! exec orch atomize --file nonexistent.md --project-root atomizeproj --project-id atomizeproj
stderr 'spec file not found'

# --specs-dir pointing at an empty/missing directory: nothing to do, exit 0.
exec orch atomize --specs-dir atomizeproj/no-such-dir --project-root atomizeproj --project-id atomizeproj
stdout 'Nada que hacer\.'

# Bug 18: a spec nested under specs/ gets a specRef relative to spec_root,
# not to the project root or to some other hardcoded prefix — nestedproj's
# tasks.json ends up with "api/auth.md#F0.1.T1", the exact shape
# prompt_builder composes {spec_root}/{spec_ref} against.
exec orch atomize --apply --project-root nestedproj --project-id nestedproj
exec cat nestedproj/tasks.json
stdout '"specRef": "api/auth\.md#F0\.1\.T1"'
! stdout 'specs/api/auth\.md'
! stdout '"specRef": "auth\.md#F0\.1\.T1"'

# --file naming a spec outside the specs root still parses it (the same
# bare-filename specRef fallback as before), but now warns on stderr that
# the resulting specRef won't resolve against spec_root. Not an error —
# exit 0, same as any other dry-run diff.
exec orch atomize --file nestedproj/outside.md --project-root nestedproj --project-id nestedproj
stderr 'is outside .*nestedproj[/\\]specs, so its specRef is just .outside\.md.'
stderr 'any subdirectory is lost'
stdout '=== Atomizer diff ==='

# Bug 19, end to end: a project scaffolded blank by `orch init` ships its
# own specs/README.md, whose ```markdown fence contains a real-looking
# example (F0.1.T1 "Setup monorepo", F0.1.T2 "Root README"). Before the
# fence fix, `orch atomize --apply` with no --file over a fresh project
# imported that example as two real tasks — invisible until bug 18 made
# specs/ (rather than a nonexistent docs/) the root actually scanned.
exec orch init blankproj
exec orch atomize --apply --project-root blankproj --project-id blankproj
stdout 'Specs escaneados: 1 archivos, 0 tasks encontradas'
exec cat blankproj/tasks.json
stdout '"tasks": \[\]'

-- atomizeproj/tasks.json --
{"meta":{},"phases":[],"tasks":[]}
-- atomizeproj/scripts/task-start.sh --
#!/usr/bin/env bash
exit 0
-- atomizeproj/specs/spec.md --
# F0 — Foundation

## F0.1 — Package: core

### F0.1.T1 — First task

Body text for the first task.

- **Modelo**: claude-sonnet-4-6
- **Estimación**: 2h

### F0.1.T2 — Second task

- **Modelo**: claude-opus-4-7
- **Estimación**: 1h
- **Dependencies**: F0.1.T1
-- nestedproj/tasks.json --
{"meta":{},"phases":[],"tasks":[]}
-- nestedproj/scripts/task-start.sh --
#!/usr/bin/env bash
exit 0
-- nestedproj/specs/api/auth.md --
# F0 — Auth

## F0.1 — Package: auth

### F0.1.T1 — Login endpoint

- **Modelo**: claude-sonnet-4-6
- **Estimación**: 3h
-- nestedproj/outside.md --
# F9 — Outside

## F9.1 — Package: outside

### F9.1.T1 — Outside task

- **Modelo**: claude-sonnet-4-6
- **Estimación**: 1h
