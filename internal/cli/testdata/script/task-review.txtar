# The Changes tab's actions from the CLI (#454): `orch task accept` merges a
# task's PR, `orch task note --retry` sends the task back with the note.

# Send back: done reopens to todo (TestTaskNoteRetryWritesTheNote reads the
# note back from the database).
exec orch tasks --project-root $WORK/rproj
exec orch task set --id T-1 --status done --project-root $WORK/rproj
exec orch task note --id T-1 --retry rename the flag --project-root $WORK/rproj
stdout '^task T-1: sent back with the note \(T-1 done -> todo\)$'
exec orch tasks --project-root $WORK/rproj --json
stdout '"id":"T-1"[^}]*"status":"todo"'

# Accept: a task that never opened a PR has nothing to merge.
! exec orch task accept --id T-1 --project-root $WORK/rproj
stderr 'T-1: the task has no PR to merge'

# Local mode has no PR (#469): Accept squash-merges orch/T-1 into main here,
# with the run's message, and the task is done.
cp $WORK/local.yaml $WORK/rproj/.orchestrator/config.yaml
cd $WORK/rproj
exec git init -q -b main
exec git add tasks.json
exec git -c user.email=t@t -c user.name=t commit -q -m initial
exec git checkout -q -b orch/T-1
cp $WORK/flag.txt flag.txt
exec git add flag.txt
exec git -c user.email=t@t -c user.name=t commit -q -m wip
exec git checkout -q main
exec orch task accept --id T-1 --project-root $WORK/rproj
stdout '^T-1 accepted: merged into main as [0-9a-f]{7}$'
exists flag.txt
exec git log -1 --format=%s main
stdout '^add the flag$'
exec orch tasks --project-root $WORK/rproj --json
stdout '"id":"T-1"[^}]*"status":"done"'

-- local.yaml --
dispatch:
  base_branch: main
vcs:
  provider: local
-- flag.txt --
on
-- rproj/tasks.json --
{"tasks":[{"id":"T-1","phase":1,"title":"add the flag","model":"claude/haiku","status":"todo","dependencies":[],"estimateHours":1.0,"files":[],"specRef":"","reason":""}]}
-- rproj/.orchestrator/config.yaml --
dispatch:
  base_branch: main
-- rproj/scripts/task-start.sh --
#!/bin/sh
exec orch task-status "$1" in-progress
