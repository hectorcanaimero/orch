# Generated by `orch init` (Sprint G-1). Safe to edit — orch never
# overwrites this file once it exists.
#
# Runs on every PR so `orch`'s auto-PR / CI-polling / auto-merge loop
# (see config.yaml's `vcs:` and `github:` sections) has a check to watch.
name: orch-ci

on:
  pull_request:
  push:
    branches: [main]

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - name: Install dependencies
        run: pip install -e .[dev]
      - name: Run tests
        run: TEST_COMMAND
