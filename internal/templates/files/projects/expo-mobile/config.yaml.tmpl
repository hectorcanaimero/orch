# Generated by `orch init --template expo-mobile`. Edit freely.
#
# The full default schema (concurrency, budget, retry, dashboard, github,
# notifications, presentation) is applied at load time — only override what
# you need.

concurrency:
  global_max: 3
  per_provider:
    claude: 2
    codex: 1
    opencode: 2

# Where this project keeps its specs. `specRef` in tasks.json is joined
# onto this to build the "Spec ref (READ FIRST)" line of every prompt.
spec_root: specs

state:
  backend: sqlite           # default since v0.11 — single orch.db, WAL journaling
  sqlite_path: null

dispatch:
  worktree_mode: true       # per-task git isolation — recommended for expo-mobile
  base_branch: main

vcs:
  provider: github
  auto_pr: true             # PR per task — turn off if you prefer raw branches
  ci_max_retries: 1

github:
  # Type-check and unit tests only. A CI runner has no simulator and no
  # device, so `expo start` and anything that needs one belong on your
  # machine, not here — a workflow that tries produces a red build that
  # says nothing about the code.
  test_command: npm run typecheck && npm test -- --ci
  auto_merge: false         # opt-in; requires branch protection

# Uncomment to enable a stakeholder-shareable dashboard URL:
# dashboard:
#   tunnel:
#     enabled: true
#     auto_start: true
