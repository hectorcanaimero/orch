# Generated by `orch init --template python-api`. Edit freely.
#
# The full default schema (concurrency, budget, retry, dashboard, github,
# notifications, presentation) is applied at load time by
# `orchestrator.config_loader._apply_defaults` — only override what you need.

concurrency:
  global_max: 4
  per_provider:
    claude: 2
    codex: 1
    opencode: 2

# Where this project keeps its specs. `specRef` in tasks.json is joined
# onto this to build the "Spec ref (READ FIRST)" line of every prompt.
spec_root: specs

state:
  backend: sqlite           # default since v0.11 — single orch.db, WAL journaling
  sqlite_path: null

dispatch:
  worktree_mode: true       # per-task git isolation — recommended for python-api
  base_branch: main

vcs:
  provider: github
  auto_pr: true             # PR per task — turn off if you prefer raw branches
  ci_max_retries: 1

github:
  test_command: pytest      # what CI runs on every PR
  auto_merge: false         # opt-in; requires branch protection

# Uncomment to enable a stakeholder-shareable dashboard URL:
# (a Cloudflare quick tunnel: needs cloudflared, and every visitor needs the
# token in the link `orch dashboard --tunnel` or the Tunnel page gives you)
# tunnel:
#   enabled: true
