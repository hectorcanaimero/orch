# Runtime artifacts — orchestrator writes here at run time, never checked in.
# Keep the directory tracked via .gitkeep, ignore everything else.
state/*
!state/.gitkeep

# Runtime state when running orch from a non-repo-root cwd (SQLite backend etc.)
orchestrator/state/

# Python build / cache
__pycache__/
*.pyc
*.pyo
.venv/
venv/
dist/
build/
*.egg-info/
.pytest_cache/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Claude Code — personal overrides (settings.json is committed for team-wide config)
.claude/settings.local.json
.claude/worktrees/

# Tooling caches
.playwright-mcp/
.mypy_cache/
.ruff_cache/
# SDD / brainstorm artifacts — local design docs, not part of the codebase
docs/design/

# Playwright preview screenshots (dev only)
/*.png
/tasks.json

# Node / frontend
node_modules/
.vite/
frontend/.env
frontend/.env.local
frontend/*.log
coverage/

# Compiled SPA is built by CI (.github/workflows/release.yml) on tag
# push and shipped inside the release wheel. Regen locally with
# `bash scripts/build-spa.sh` if you need to test the packaged mount.
orchestrator/spa/
