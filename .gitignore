# Runtime artifacts — orchestrator writes here at run time, never checked in.
# Keep the directory tracked via .gitkeep, ignore everything else.
state/*
!state/.gitkeep

# Runtime state when running orch from a non-repo-root cwd (SQLite backend etc.)
orchestrator/state/

# Python build / cache
__pycache__/
*.pyc
*.pyo
.venv/
venv/
# Anchored to the repo root — `python -m build --outdir dist` (see
# scripts/build-wheel.sh) is the only thing this was ever for. An
# unanchored `dist/` would also match internal/dashboard/dist/, which
# needs one tracked file (dist/README.md) alongside its own gitignored
# dist/build/ — see the Node / frontend section below.
/dist/
build/
*.egg-info/
.pytest_cache/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Claude Code — personal overrides (settings.json is committed for team-wide config)
.claude/settings.local.json
.claude/worktrees/

# Tooling caches
.playwright-mcp/
.mypy_cache/
.ruff_cache/
# SDD / brainstorm artifacts — local design docs, not part of the codebase
docs/design/

# Playwright preview screenshots (dev only)
/*.png
/tasks.json

# Node / web (frontend/ moved to web/ in G5.1)
# A worktree that built the SPA before the move still has an untracked
# frontend/dist/ that no rule covers; the next `git add -A` drags the
# minified React bundle into a PR (778 KB in #160, which killed the Gemini
# review job). The directory no longer exists in the repo, so ignore it whole.
/frontend/
node_modules/
.vite/
web/.env
web/.env.local
web/*.log
coverage/

# internal/dashboard/dist/build/ (web/'s vite build.outDir — see
# web/vite.config.ts) is already caught by the unanchored `build/` rule
# above; dist/README.md, one level up, stays tracked since `dist/` itself
# isn't ignored.

# Compiled SPA is built by CI (.github/workflows/release.yml) on tag
# push and shipped inside the release wheel. Regen locally with
# `bash scripts/build-spa.sh` if you need to test the packaged mount.
orchestrator/spa/

# web/vite.stakeholder.config.ts's outDir (pnpm build:stakeholder) — not
# named "build", so the unanchored build/ rule above doesn't catch it.
# Same 778 KB-bundle-in-a-PR hazard the frontend/dist/ note above exists
# for. Only the bundle itself is ignored, NOT its parent: G6.3's
# internal/publish/bundle.go embeds `dist`, and a go:embed pattern
# matching zero files is a compile error — so dist/README.md stays
# tracked, exactly as internal/dashboard/dist/README.md does.
internal/publish/dist/stakeholder/

# Go build output
bin/
coverage.out
