# Development-only environment file (.env.local is gitignored)
#
# Use this ONLY when running Vite dev server (:5173) and FastAPI dashboard (:7420)
# on separate ports. When split-origin, the SPA cannot use window.location.origin
# because it runs on a different origin than the backend.
#
# To use: copy this to `.env.local` and start the dashboard with ORCH_DASHBOARD_DEV_CORS=1
#
# In production (dashboard serving SPA), leave .env unset and .env.local missing
# so the SPA uses window.location.origin (same-origin, no CORS, port-agnostic).

VITE_API_BASE_URL=http://127.0.0.1:7420
