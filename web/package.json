    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-query-devtools": "^5.59.0",
    "axios": "^1.7.7",
    "class-variance-authority": "^0.7.1",
